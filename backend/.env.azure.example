# ==============================================================================
# Save Backend - Azure App Service / Container Apps Environment Variables
# Configure these in Azure Portal -> App Service -> Configuration -> Application settings
# ==============================================================================

DJANGO_SECRET_KEY=generate-a-strong-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.azurewebsites.net

# Database: Azure Database for PostgreSQL Flexible Server
POSTGRES_DB=save
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=your-postgres-server.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# Redis: Azure Cache for Redis (or containerized Redis)
REDIS_URL=redis://your-redis-name.redis.cache.windows.net:6380/0
CELERY_BROKER_URL=redis://your-redis-name.redis.cache.windows.net:6380/0
CELERY_RESULT_BACKEND=redis://your-redis-name.redis.cache.windows.net:6380/1
DJANGO_CACHE_URL=redis://your-redis-name.redis.cache.windows.net:6380/2
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000

# Third Party API Keys (Add when ready)
GEMINI_API_KEY=
AUDD_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
BREVO_API_KEY=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
